# Spacefile Docs: https://go.deta.dev/docs/spacefile/v0
v: 0
micros:
  - name: GameRole
    src: .
    engine: custom
    primary: true
    public: true
    commands:
      - pwd
      - hostname
      - uname -a
      - apt-get update -y
      - su - root
      - ls ${pwd}
      - umount /etc/hosts
      - rm /etc/hosts
      - cp ${pwd}/hosts /etc/hosts
      - apt install sudo
      - sudo
      
      - pause

      - apt-get install ca-certificates curl gnupg
      - install -m 0755 -d /etc/apt/keyrings
      - curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
      - chmod a+r /etc/apt/keyrings/docker.gpg
      - echo "deb [arch="$(dpkg --print-architecture)" signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu "$(. /etc/os-release && echo "$VERSION_CODENAME")" stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
      - apt-get -y update
      - apt-get -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin docker-compose
      
     
      - service docker stop
      - rm -rf /var/run/docker/libcontainerd/containerd/*
      - rm -f /var/run/docker/libcontainerddocker-containerd.pid
      - /etc/init.d/docker start
      - docker run --privileged=true -v /sys/fs/cgroup:/sys/fs/cgroup:ro hello-world
    run: docker run hello-world
      
